{"seq":376,"elapsed_ms":3221,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input reset,\n    input [2:0] s,\n    output reg fr2,\n    output reg fr1,\n    output reg fr0,\n    output reg dfr\n);\n\n    reg [2:0] prev;\n\n    always @(posedge clk) begin\n        if (reset) begin\n            prev <= 3'b000;\n        end else begin\n            prev <= s;\n        end\n    end\n\n    always @(*) begin\n        case (s)\n            3'b111: begin\n                fr2 = 1'b0;\n                fr1 = 1'b0;\n                fr0 = 1'b0;\n                dfr = 1'b0;\n            end\n            3'b011: begin\n                fr2 = 1'b0;\n                fr1 = 1'b0;\n                fr0 = 1'b1;\n                dfr = (prev < s) ? 1'b1 : 1'b0;\n            end\n            3'b001: begin\n                fr2 = 1'b0;\n                fr1 = 1'b1;\n                fr0 = 1'b1;\n                dfr = (prev < s) ? 1'b1 : 1'b0;\n            end\n            3'b000: begin\n                fr2 = 1'b1;\n                fr1 = 1'b1;\n                fr0 = 1'b1;\n                dfr = 1'b1;\n            end\n            default: begin\n                fr2 = 1'b0;\n                fr1 = 1'b0;\n                fr0 = 1'b0;\n                dfr = 1'b0;\n            end\n        endcase\n    end\n\nendmodule\n[DONE]"}}}
