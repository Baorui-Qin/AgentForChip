{"seq":554,"elapsed_ms":3987,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input reset,\n    input data,\n    output [3:0] count,\n    output counting,\n    output done,\n    input ack\n);\n\n    localparam IDLE  = 2'd0;\n    localparam DELAY = 2'd1;\n    localparam COUNT = 2'd2;\n    localparam DONE  = 2'd3;\n\n    reg [1:0] state;\n    reg [3:0] sr;\n    reg [3:0] delay_reg;\n    reg [1:0] bitcnt;\n    reg [3:0] count_reg;\n    reg [9:0] timer;\n\n    assign counting = (state == COUNT);\n    assign done     = (state == DONE);\n    assign count    = count_reg;\n\n    always @(posedge clk) begin\n        if (reset) begin\n            state     <= IDLE;\n            sr        <= 4'b0;\n            delay_reg <= 4'b0;\n            bitcnt    <= 2'd0;\n            count_reg <= 4'b0;\n            timer     <= 10'd0;\n        end else begin\n            case (state)\n                IDLE: begin\n                    sr <= {sr[2:0], data};\n                    if ({sr[2:0], data} == 4'b1101) begin\n                        state     <= DELAY;\n                        bitcnt    <= 2'd0;\n                        delay_reg <= 4'b0;\n                    end\n                end\n\n                DELAY: begin\n                    delay_reg <= {delay_reg[2:0], data};\n                    if (bitcnt == 2'd3) begin\n                        state     <= COUNT;\n                        count_reg <= {delay_reg[2:0], data};\n                        timer     <= 10'd999;\n                    end else begin\n                        bitcnt <= bitcnt + 1'b1;\n                    end\n                end\n\n                COUNT: begin\n                    if (timer == 10'd0) begin\n                        if (count_reg == 4'd0) begin\n                            state <= DONE;\n                        end else begin\n                            count_reg <= count_reg - 1'b1;\n                            timer     <= 10'd999;\n                        end\n                    end else begin\n                        timer <= timer - 1'b1;\n                    end\n                end\n\n                DONE: begin\n                    if (ack) begin\n                        state <= IDLE;\n                        sr    <= 4'b0;\n                    end\n                end\n\n                default: state <= IDLE;\n            endcase\n        end\n    end\n\nendmodule\n[DONE]"}}}
