{"seq":181,"elapsed_ms":2867,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input areset,\n    input x,\n    output z\n);\n\n    localparam A = 2'b00,\n               B = 2'b01,\n               C = 2'b10;\n\n    reg [1:0] state, next_state;\n\n    always @(posedge clk or posedge areset) begin\n        if (areset)\n            state <= A;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        case (state)\n            A: next_state = x ? B : A;\n            B: next_state = x ? C : B;\n            C: next_state = x ? C : B;\n            default: next_state = A;\n        endcase\n    end\n\n    assign z = (state == B);\n\nendmodule\n[DONE]"}}}
