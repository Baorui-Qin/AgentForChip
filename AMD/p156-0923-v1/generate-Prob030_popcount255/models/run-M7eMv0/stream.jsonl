{"seq":536,"elapsed_ms":3449,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n  input  logic [254:0] in,\n  output logic [7:0] out\n);\n\n  logic [255:0] padded;\n  assign padded = {1'b0, in};\n\n  logic [1:0] s1 [0:127];\n  logic [2:0] s2 [0:63];\n  logic [3:0] s3 [0:31];\n  logic [4:0] s4 [0:15];\n  logic [5:0] s5 [0:7];\n  logic [6:0] s6 [0:3];\n  logic [7:0] s7 [0:1];\n\n  genvar i;\n  generate\n    for (i = 0; i < 128; i = i + 1) begin : gen_s1\n      assign s1[i] = padded[2*i] + padded[2*i+1];\n    end\n    for (i = 0; i < 64; i = i + 1) begin : gen_s2\n      assign s2[i] = s1[2*i] + s1[2*i+1];\n    end\n    for (i = 0; i < 32; i = i + 1) begin : gen_s3\n      assign s3[i] = s2[2*i] + s2[2*i+1];\n    end\n    for (i = 0; i < 16; i = i + 1) begin : gen_s4\n      assign s4[i] = s3[2*i] + s3[2*i+1];\n    end\n    for (i = 0; i < 8; i = i + 1) begin : gen_s5\n      assign s5[i] = s4[2*i] + s4[2*i+1];\n    end\n    for (i = 0; i < 4; i = i + 1) begin : gen_s6\n      assign s6[i] = s5[2*i] + s5[2*i+1];\n    end\n    for (i = 0; i < 2; i = i + 1) begin : gen_s7\n      assign s7[i] = s6[2*i] + s6[2*i+1];\n    end\n  endgenerate\n\n  assign out = s7[0] + s7[1];\n\nendmodule\n[DONE]"}}}
