{"seq":287,"elapsed_ms":2961,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input reset,\n    input s,\n    input w,\n    output z\n);\n\n    localparam A = 3'd0,\n               B = 3'd1,\n               C = 3'd2,\n               D = 3'd3,\n               E = 3'd4;\n\n    reg [2:0] state, next_state;\n    reg [1:0] cnt;\n\n    always @(*) begin\n        case (state)\n            A: next_state = s ? B : A;\n            B: next_state = C;\n            C: next_state = D;\n            D: next_state = E;\n            E: next_state = B;\n            default: next_state = A;\n        endcase\n    end\n\n    always @(posedge clk) begin\n        if (reset) begin\n            state <= A;\n            cnt <= 2'd0;\n        end else begin\n            state <= next_state;\n\n            if (state == B)\n                cnt <= {1'b0, w};\n            else if (state == C || state == D)\n                cnt <= cnt + {1'b0, w};\n            else\n                cnt <= 2'd0;\n        end\n    end\n\n    assign z = (state == E) && (cnt == 2'd2);\n\nendmodule\n[DONE]"}}}
