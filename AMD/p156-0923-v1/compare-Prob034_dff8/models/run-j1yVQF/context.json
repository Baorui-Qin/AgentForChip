{
  "task": {
    "id": "Prob034_dff8",
    "spec": "\r\nI would like you to implement a module named TopModule with the following\r\ninterface. All input and output ports are one bit unless otherwise\r\nspecified.\r\n\r\n - input  clk\r\n - input  d   (8 bits)\r\n - output q   (8 bits)\r\n\r\nThe module should include 8 D flip-flops. All DFFs should be triggered by\r\nthe positive edge of clock.\r\n\r\n",
    "interface": {
      "top": "TopModule",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "d",
          "direction": "input",
          "width": 8,
          "signed": false
        },
        {
          "name": "q",
          "direction": "output",
          "width": 8,
          "signed": false
        }
      ]
    },
    "constraints": "SystemVerilog, exactly one self-contained TopModule DUT. Inline all helper logic inside TopModule; do not define auxiliary modules. xczu3eg-sbva484-1-e; 5 ns synthesis clock; simulator seed 1. No reference dependencies, hierarchy outside the DUT, file access, includes or DPI."
  },
  "sample_id": "bdf31d21-8610-49a4-9ed6-249952f6871e",
  "variant_id": "C",
  "current": {
    "revision_id": "65bb16e7-901a-4ae2-b36d-1337966a6f88",
    "source_sha256": "df6bf7ba62d53ad8ccd1da5481f4c5e5f7ae38a5651a8abbc514cb3ec960dbeb",
    "source": "\nmodule TopModule (\n    input  logic       clk,\n    input  logic [7:0] d,\n    output logic [7:0] q\n);\n\n    always_ff @(posedge clk) begin\n        q <= d;\n    end\n\nendmodule\n"
  },
