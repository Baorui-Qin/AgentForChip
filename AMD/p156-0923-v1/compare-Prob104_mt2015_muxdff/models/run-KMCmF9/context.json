{
  "task": {
    "id": "Prob104_mt2015_muxdff",
    "spec": "\r\nI would like you to implement a module named TopModule with the following\r\ninterface. All input and output ports are one bit unless otherwise\r\nspecified.\r\n\r\n - input  clk\r\n - input  L\r\n - input  q_in\r\n - input  r_in\r\n - output Q\r\n\r\nConsider this Verilog module \"full_module\":\r\n\r\n  module full_module (\r\n      input [2:0] r,\r\n      input L,\r\n      input clk,\r\n      output reg [2:0] q);\r\n\r\n    always @(posedge clk) begin\r\n      if (L) begin\r\n        q <= r;\r\n      end else begin\r\n        q <= {q[1] ^ q[2], q[0], q[2]};\r\n      end\r\n    end\r\n\r\n  endmodule\r\n\r\nNote that q[2:0] is three bits wide, representing three flip-flops that can be\r\nloaded from r when L is asserted. You want to factor full_module into a hierarchical\r\ndesign, flipflop and 2:1 multiplexer are in a submodule \"TopModule\", and that submodule\r\nwill be instantiated three times in full_module code. Create the submodule called \"TopModule\".\r\nYou do not have to provide the revised full_module.\r\n\r\n",
    "interface": {
      "top": "TopModule",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "L",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "q_in",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "r_in",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "Q",
          "direction": "output",
          "width": 1,
          "signed": false
        }
      ]
    },
    "constraints": "SystemVerilog, exactly one self-contained TopModule DUT. Inline all helper logic inside TopModule; do not define auxiliary modules. xczu3eg-sbva484-1-e; 5 ns synthesis clock; simulator seed 1. No reference dependencies, hierarchy outside the DUT, file access, includes or DPI."
  },
  "sample_id": "529d22e4-f583-45b6-963c-228192531e60",
  "variant_id": "C",
  "current": {
    "revision_id": "77ac1c5a-0123-42d3-9979-7b44d1a35339",
    "source_sha256": "148f53a9804763b2cb154d1a1d6f0884b991b7cfc2f6ae9fc5b8ee0a35c82f57",
    "source": "\nmodule TopModule (\n    input  logic clk,\n    input  logic L,\n    input  logic q_in,\n    input  logic r_in,\n    output logic Q\n);\n\n    always_ff @(posedge clk) begin\n        if (L)\n            Q <= r_in;\n        else\n            Q <= q_in;\n    end\n\nendmodule\n"
  },
