{"seq":344,"elapsed_ms":2942,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input reset,\n    input in,\n    output done\n);\n\n    localparam IDLE  = 3'd0,\n               START = 3'd1,\n               DATA  = 3'd2,\n               STOP  = 3'd3,\n               DONE  = 3'd4,\n               WAIT  = 3'd5;\n\n    reg [2:0] state, next_state;\n    reg [3:0] bit_cnt;\n\n    always @(posedge clk) begin\n        if (reset) begin\n            state   <= IDLE;\n            bit_cnt <= 4'd0;\n        end else begin\n            state <= next_state;\n\n            if (state == IDLE)\n                bit_cnt <= 4'd0;\n            else if (state == START)\n                bit_cnt <= 4'd0;\n            else if (state == DATA)\n                bit_cnt <= bit_cnt + 4'd1;\n        end\n    end\n\n    always @(*) begin\n        case (state)\n            IDLE:  next_state = in ? IDLE : START;\n            START: next_state = DATA;\n            DATA:  next_state = (bit_cnt == 4'd7) ? STOP : DATA;\n            STOP:  next_state = in ? DONE : WAIT;\n            DONE:  next_state = in ? IDLE : START;\n            WAIT:  next_state = in ? IDLE : WAIT;\n            default: next_state = IDLE;\n        endcase\n    end\n\n    assign done = (state == DONE);\n\nendmodule\n[DONE]"}}}
