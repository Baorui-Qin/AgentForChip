{"seq":478,"elapsed_ms":4063,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input in,\n    input reset,\n    output reg [7:0] out_byte,\n    output wire done\n);\n\n    localparam IDLE  = 3'd0,\n               START = 3'd1,\n               DATA  = 3'd2,\n               STOP  = 3'd3,\n               WAIT  = 3'd4;\n\n    reg [2:0] state, next_state;\n    reg [3:0] bit_cnt;\n    reg [7:0] data_reg;\n\n    always @(*) begin\n        case (state)\n            IDLE:  next_state = in ? IDLE : START;\n            START: next_state = DATA;\n            DATA:  next_state = (bit_cnt == 4'd7) ? STOP : DATA;\n            STOP:  next_state = in ? IDLE : WAIT;\n            WAIT:  next_state = in ? IDLE : WAIT;\n            default: next_state = IDLE;\n        endcase\n    end\n\n    always @(posedge clk) begin\n        if (reset) begin\n            state    <= IDLE;\n            bit_cnt  <= 4'd0;\n            data_reg <= 8'd0;\n            out_byte <= 8'd0;\n        end else begin\n            state <= next_state;\n\n            case (state)\n                IDLE: begin\n                    bit_cnt <= 4'd0;\n                end\n\n                START: begin\n                    data_reg[0] <= in;\n                    bit_cnt     <= 4'd1;\n                end\n\n                DATA: begin\n                    data_reg[bit_cnt] <= in;\n                    if (bit_cnt == 4'd7)\n                        bit_cnt <= 4'd0;\n                    else\n                        bit_cnt <= bit_cnt + 4'd1;\n                end\n\n                STOP: begin\n                    if (in) begin\n                        out_byte <= data_reg;\n                    end\n                end\n\n                WAIT: begin\n                    bit_cnt <= 4'd0;\n                end\n\n                default: begin\n                    bit_cnt <= 4'd0;\n                end\n            endcase\n        end\n    end\n\n    assign done = (state == STOP) && in;\n\nendmodule\n[DONE]"}}}
