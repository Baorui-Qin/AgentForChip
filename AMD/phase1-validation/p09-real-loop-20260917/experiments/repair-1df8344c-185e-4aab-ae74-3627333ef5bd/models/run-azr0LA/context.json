  "task": {
    "id": "rising_edge",
    "spec": "A registered rising-edge detector. Reset clears previous input and pulse. Otherwise pulse becomes din AND NOT the previous sampled din, and previous input becomes din. Consecutive high samples must not repeat the pulse.\nUse one SystemVerilog module with the exact interface. All state updates on rising clk. rst is synchronous, active high, and has priority. No other modules, file I/O, delays, or simulation-only behavior in the DUT.",
    "interface": {
      "top": "rising_edge",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "rst",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "din",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "pulse",
          "direction": "output",
          "width": 1,
          "signed": false
        }
      ]
    },
    "constraints": "SystemVerilog; xczu3eg-sbva484-1-e; post-synthesis clock clk at 5 ns; simulation seed 1."
  },
  "sample_id": "1df8344c-185e-4aab-ae74-3627333ef5bd",
  "variant_id": "A",
  "current": {
    "revision_id": "389adbb3-2823-4bd9-b23f-6937eead99c8",
    "source_sha256": "3349414a72a45ce35dc8cd4a9ffa9fcd48d1da6195d0e2669980e9caf108a844",
    "source": "module rising_edge(input clk, rst, din, output reg pulse);\nreg previous;\nalways @(posedge clk) if(rst) begin previous<=0; pulse<=0; end else begin pulse<=din; previous<=din; end\nendmodule\n"
