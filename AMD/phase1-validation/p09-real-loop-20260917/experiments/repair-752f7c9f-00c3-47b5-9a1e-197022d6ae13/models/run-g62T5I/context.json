{
  "task": {
    "id": "controlled_multi_round_reset",
    "spec": "Write synthesizable SystemVerilog for exactly one module named counter with ports input wire clk, input wire rst, output reg [3:0] count.\nOn each rising edge of clk, synchronously set count to 4'b0000 if rst is high; otherwise increment count by one modulo 16. No other behavior is required.\nReturn only the complete RTL source, without Markdown or explanation. Do not include a testbench, includes, preprocessor directives, file I/O, system tasks, DPI, delays, initial blocks, or additional modules.",
    "interface": {
      "top": "counter",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1
        },
        {
          "name": "rst",
          "direction": "input",
          "width": 1
        },
        {
          "name": "count",
          "direction": "output",
          "width": 4
        }
      ]
    },
    "constraints": "SystemVerilog; xczu3eg-sbva484-1-e; 5 ns clk; seed 1."
  },
  "sample_id": "752f7c9f-00c3-47b5-9a1e-197022d6ae13",
  "variant_id": "A",
  "current": {
    "revision_id": "b9598af0-3050-49ca-a6e4-0dcf4a995fec",
    "source_sha256": "10e9a386397e744dbd2b86df0825e4d77d12b3020283dbc4a3bed80172e2c77b",
    "source": "module counter(input wire clk, input wire rst, output reg [3:0] count);\nalways @(posedge clk) begin\n    if (rst) count <= 4'b1111;\n    else count <= count + 1\nend\nendmodule\n"
