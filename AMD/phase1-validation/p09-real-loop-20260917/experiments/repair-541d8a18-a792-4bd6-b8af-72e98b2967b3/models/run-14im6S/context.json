  "sample_id": "541d8a18-a792-4bd6-b8af-72e98b2967b3",
  "variant_id": "A",
  "current": {
    "revision_id": "9b258698-5ef4-4214-bf39-f521ac05e161",
    "source_sha256": "d48e026f86450796d799574791e999040599b41b58950cc59cb35bf2cbdc974f",
    "source": "module signed_saturating_add(input clk,rst,input signed [7:0] a,b,output reg signed [7:0] sum);\nwire signed [8:0] extended={a[7],a}+{b[7],b};\nalways @(posedge clk) if(rst) sum<=0; else if(extended>127) sum<=126; else if(extended< -128) sum<= -128; else sum<=extended[7:0];\nendmodule\n"
  },
