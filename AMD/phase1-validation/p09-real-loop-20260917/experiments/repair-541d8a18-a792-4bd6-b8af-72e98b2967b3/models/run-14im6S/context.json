{
  "task": {
    "id": "signed_saturating_add",
    "spec": "Register the mathematical sum of signed 8-bit a and b each rising edge, clamped to [-128,127]. Reset sum to zero. No enable or extra pipeline latency.\nUse one SystemVerilog module with the exact interface. All state updates on rising clk. rst is synchronous, active high, and has priority. No other modules, file I/O, delays, or simulation-only behavior in the DUT.",
    "interface": {
