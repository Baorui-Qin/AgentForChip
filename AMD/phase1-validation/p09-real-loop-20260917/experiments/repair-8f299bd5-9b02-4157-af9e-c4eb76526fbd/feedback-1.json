{"task":{"id":"rising_edge","spec":"A registered rising-edge detector. Reset clears previous input and pulse. Otherwise pulse becomes din AND NOT the previous sampled din, and previous input becomes din. Consecutive high samples must not repeat the pulse.\nUse one SystemVerilog module with the exact interface. All state updates on rising clk. rst is synchronous, active high, and has priority. No other modules, file I/O, delays, or simulation-only behavior in the DUT.","interface":{"top":"rising_edge","ports":[{"name":"clk","direction":"input","width":1,"signed":false},{"name":"rst","direction":"input","width":1,"signed":false},{"name":"din","direction":"input","width":1,"signed":false},{"name":"pulse","direction":"output","width":1,"signed":false}]},"constraints":"SystemVerilog; xczu3eg-sbva484-1-e; post-synthesis clock clk at 5 ns; simulation seed 1."},"sample_id":"8f299bd5-9b02-4157-af9e-c4eb76526fbd","variant_id":"B","current":{"revision_id":"1b8e1d49-a1c7-4574-9481-c0e9d7a14352","source_sha256":"3349414a72a45ce35dc8cd4a9ffa9fcd48d1da6195d0e2669980e9caf108a844","source":"module rising_edge(input clk, rst, din, output reg pulse);\nreg previous;\nalways @(posedge clk) if(rst) begin previous<=0; pulse<=0; end else begin pulse<=din; previous<=din; end\nendmodule\n"},"binding":{"revision_id":"1b8e1d49-a1c7-4574-9481-c0e9d7a14352","source_sha256":"3349414a72a45ce35dc8cd4a9ffa9fcd48d1da6195d0e2669980e9caf108a844","verification_key":"sha256:24873ef946df9b0342615e41225416f053c027ab854769d3bd5d14500d6737b1"},"feedback":{"schema_version":"1.4","evidence_kind":"live_verification","eda_rerun":false,"model_repair_executed":false,"original_run":"D:\\AMD\\phase1-validation\\p09-real-loop-20260917\\experiments\\repair-8f299bd5-9b02-4157-af9e-c4eb76526fbd\\eda\\run-rzGBxm","result_sha256":"ca0b547f86487e552f4312790daad76d51c47bac3d61a30459933c4023a0cd09","parser_version":"counter-diagnostics-1","parser_sha256":"993dac0e34cf5e8023cff1001b673477a5bcd7a34cf8ec738dde324c5b36063c","inp