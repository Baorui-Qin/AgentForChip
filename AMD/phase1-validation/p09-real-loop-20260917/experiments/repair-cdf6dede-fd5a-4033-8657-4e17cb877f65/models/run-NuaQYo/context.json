          "name": "clk",
          "direction": "input",
          "width": 1
        },
        {
          "name": "rst",
          "direction": "input",
          "width": 1
        },
        {
          "name": "count",
          "direction": "output",
          "width": 4
        }
      ]
    },
    "constraints": "SystemVerilog; xczu3eg-sbva484-1-e; 5 ns clk; seed 1."
