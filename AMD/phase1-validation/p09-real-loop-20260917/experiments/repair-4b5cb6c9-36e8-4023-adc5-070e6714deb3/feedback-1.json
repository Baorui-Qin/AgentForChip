{"task":{"id":"signed_saturating_add","spec":"Register the mathematical sum of signed 8-bit a and b each rising edge, clamped to [-128,127]. Reset sum to zero. No enable or extra pipeline latency.\nUse one SystemVerilog module with the exact interface. All state updates on rising clk. rst is synchronous, active high, and has priority. No other modules, file I/O, delays, or simulation-only behavior in the DUT.","interface":{"top":"signed_saturating_add","ports":[{"name":"clk","direction":"input","width":1,"signed":false},{"name":"rst","direction":"input","width":1,"signed":false},{"name":"a","direction":"input","width":8,"signed":true},{"name":"b","direction":"input","width":8,"signed":true},{"name":"sum","direction":"output","width":8,"signed":true}]},"constraints":"SystemVerilog; xczu3eg-sbva484-1-e; post-synthesis clock clk at 5 ns; simulation seed 1."},"sample_id":"4b5cb6c9-36e8-4023-adc5-070e6714deb3","variant_id":"B","current":{"revision_id":"df1af5b4-be30-4cc5-8185-407c2ee569ec","source_sha256":"d48e026f86450796d799574791e999040599b41b58950cc59cb35bf2cbdc974f","source":"module signed_saturating_add(input clk,rst,input signed [7:0] a,b,output reg signed [7:0] sum);\nwire signed [8:0] extended={a[7],a}+{b[7],b};\nalways @(posedge clk) if(rst) sum<=0; else if(extended>127) sum<=126; else if(extended< -128) sum<= -128; else sum<=extended[7:0];\nendmodule\n"},"binding":{"revision_id":"df1af5b4-be30-4cc5-8185-407c2ee569ec","source_sha256":"d48e026f86450796d799574791e999040599b41b58950cc59cb35bf2cbdc974f","verification_key":"sha256:ffe662235625c299cd9be2dc9428216d09d98d0b56fa545694956616abe22b70"},"feedback":{"schema_version":"1.4","evidence_kind":"live_verification","eda_rerun":false,"model_repair_executed":false,"original_run":"D:\\AMD\\phase1-validation\\p09-real-loop-20260917\\experiments\\repair-4b5cb6c9-36e8-4023-adc5-070e6714deb3\\eda\\run-lGXAW0","result_sha256":"781edb7c646c949445cbc437f455775eeaea4ef521d3fe63036f0fee4e024c34","parser_version":"counter-diagn