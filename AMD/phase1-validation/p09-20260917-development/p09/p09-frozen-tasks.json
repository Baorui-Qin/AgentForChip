      "task": {
        "id": "sequence_101",
        "spec": "Detect overlapping serial 101. Each non-reset rising edge consumes din; hit is high for the resulting cycle exactly when the last three non-reset samples are 101. Reset discards history and clears hit. Input 10101 produces two hits.\nUse one SystemVerilog module with the exact interface. All state updates on rising clk. rst is synchronous, active high, and has priority. No other modules, file I/O, delays, or simulation-only behavior in the DUT.",
        "interface": {
          "top": "sequence_101",
          "ports": [
            {
              "name": "clk",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "rst",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "din",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "hit",
              "direction": "output",
              "width": 1,
              "signed": false
            }
          ]
        },
        "constraints": "SystemVerilog; xczu3eg-sbva484-1-e; post-synthesis clock clk at 5 ns; simulation seed 1."
      }
    },
