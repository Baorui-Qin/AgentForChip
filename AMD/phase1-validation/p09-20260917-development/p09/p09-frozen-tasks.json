    {
      "id": "ready_valid_slot",
      "task_sha256": "8254bfbd5037d8943d49dba4e715948bf37bd1083ed9f43c95065da4f0f20bea",
      "task": {
        "id": "ready_valid_slot",
        "spec": "A single registered 8-bit ready/valid slot without empty-slot combinational bypass. out_valid indicates occupied state; out_data is the stored byte, unspecified when invalid. in_ready = !occupied || out_ready. A rising edge accepts input when in_valid && in_ready and consumes output when out_valid && out_ready; simultaneous consume/accept replaces the byte without a bubble. With output stalled, valid data remains stable. Reset empties the slot and clears stored data.\nUse one SystemVerilog module with the exact interface. All state updates on rising clk. rst is synchronous, active high, and has priority. No other modules, file I/O, delays, or simulation-only behavior in the DUT.",
        "interface": {
          "top": "ready_valid_slot",
          "ports": [
            {
              "name": "clk",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "rst",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "in_valid",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "in_data",
              "direction": "input",
              "width": 8,
              "signed": false
            },
            {
              "name": "in_ready",
              "direction": "output",
              "width": 1,
              "signed": false
            },
            {
              "name": "out_valid",
              "direction": "output",
              "width": 1,
              "signed": false
            },
            {
              "name": "out_data",
              "direction": "output",
              "width": 8,
              "signed": false
            },
            {
              "name": "out_ready",
              "direction": "input",
              "width": 1,
              "signed": false
            }
          ]
        },
        "constraints": "SystemVerilog; xczu3eg-sbva484-1-e; post-synthesis clock clk at 5 ns; simulation seed 1."
      }
    }
