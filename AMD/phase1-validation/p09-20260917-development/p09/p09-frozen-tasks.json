          "top": "enable_counter",
          "ports": [
            {
              "name": "clk",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "rst",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "en",
              "direction": "input",
              "width": 1,
              "signed": false
            },
            {
              "name": "q",
              "direction": "output",
              "width": 4,
              "signed": false
            }
          ]
        },
        "constraints": "SystemVerilog; xczu3eg-sbva484-1-e; post-synthesis clock clk at 5 ns; simulation seed 1."
      }
    },
