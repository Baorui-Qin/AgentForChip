{
  "task": {
    "id": "sequence_101",
    "spec": "Detect overlapping serial 101. Each non-reset rising edge consumes din; hit is high for the resulting cycle exactly when the last three non-reset samples are 101. Reset discards history and clears hit. Input 10101 produces two hits.\nUse one SystemVerilog module with the exact interface. All state updates on rising clk. rst is synchronous, active high, and has priority. No other modules, file I/O, delays, or simulation-only behavior in the DUT.",
    "interface": {
      "top": "sequence_101",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "rst",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "din",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "hit",
          "direction": "output",
          "width": 1,
          "signed": false
        }
      ]
    },
    "constraints": "SystemVerilog; xczu3eg-sbva484-1-e; post-synthesis clock clk at 5 ns; simulation seed 1."
  },
  "sample_id": "35ae6469-616e-4841-b87c-306756c5c209",
  "variant_id": "C",
  "current": {
    "revision_id": "bba8c815-9ef8-419b-a5c6-57a037bf2b1d",
    "source_sha256": "64502c3374039baaeecddb94b0c1a0d39467d513ecfccdfe54276c60a5908b24",
    "source": "module sequence_101(input clk, rst, din, output reg hit);\nreg [1:0] history,valid;\nalways @(posedge clk) if(rst) begin history<=0; valid<=0; hit<=0; end else begin hit<=valid[1] && history==2'b11 && din; history<={history[0],din}; valid<={valid[0],1'b1}; end\nendmodule\n"
  },
