  "current": {
    "revision_id": "2d314192-4f82-4b53-9286-9fce129b68fe",
    "source_sha256": "ec22b781e97b7a43aa41dd44d8c51694dcc19ee236a89424721b2646e25f7de0",
    "source": "module ready_valid_slot(input clk,rst,in_valid,input [7:0] in_data,output in_ready,output out_valid,output [7:0] out_data,input out_ready);\nreg full; reg [7:0] data;\nassign in_ready=~full; assign out_valid=full; assign out_data=data;\nalways @(posedge clk) if(rst) begin full<=0; data<=0; end else if(in_ready) begin full<=in_valid; if(in_valid) data<=in_data; end\nendmodule\n"
  },
