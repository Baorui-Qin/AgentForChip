{
  "task": {
    "id": "Prob078_dualedge",
    "spec": "\r\nI would like you to implement a module named TopModule with the following\r\ninterface. All input and output ports are one bit unless otherwise\r\nspecified.\r\n\r\n - input  clk\r\n - input  d\r\n - output q\r\n\r\nA dual-edge triggered flip-flop is triggered on both edges of the clock.\r\nHowever, FPGAs don't have dual-edge triggered flip-flops, and using an\r\nalways @(posedge clk or negedge clk) is not accepted as a legal\r\nsensitivity list. Build a circuit that functionally behaves like a\r\ndual-edge triggered flip-flop.\r\n\r\n",
    "interface": {
      "top": "TopModule",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "d",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "q",
          "direction": "output",
          "width": 1,
          "signed": false
        }
      ]
    },
    "constraints": "SystemVerilog, single self-contained TopModule DUT; xczu3eg-sbva484-1-e; 5 ns synthesis clock; simulator seed 1. No reference dependencies, hierarchy outside the DUT, file access, includes or DPI."
  },
  "sample_id": "3c97eae0-7204-4e55-908f-d31a33833070",
  "variant_id": "C",
  "current": {
    "revision_id": "b0e3b462-5f18-49f7-b57f-0ca6d44b0a3f",
    "source_sha256": "a35aca97c4b38cebde449ab197e23b98700c48ce210649f788aeef7e002503a5",
    "source": "module TopModule (\n    input  logic clk,\n    input  logic d,\n    output logic q\n);\n    // Two single-edge storage elements, one per clock edge. Each is loaded\n    // directly from d, so no unknown value can propagate between them.\n    logic q_pos = 1'b0;   // updated on the rising edge\n    logic q_neg = 1'b0;   // updated on the falling edge\n\n    always_ff @(posedge clk) begin\n        q_pos <= d;\n    end\n\n    always_ff @(negedge clk) begin\n        q_neg <= d;\n    end\n\n    // Select the element that was just updated: after a rising edge clk is\n    // high (use q_pos), after a falling edge clk is low (use q_neg).\n    assign q = clk ? q_pos : q_neg;\nendmodule\n"
  },
