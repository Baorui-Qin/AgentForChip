{"seq":490,"elapsed_ms":4113,"chunk":{"type":"block-end","index":1,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input  logic clk,\n    input  logic load,\n    input  logic [1:0] ena,\n    input  logic [99:0] data,\n    output logic [99:0] q\n);\n\n    always_ff @(posedge clk) begin\n        if (load) begin\n            q <= data;\n        end else begin\n            case (ena)\n                2'b01: q <= {q[0], q[99:1]};   // rotate right by 1\n                2'b10: q <= {q[98:0], q[99]};  // rotate left by 1\n                default: q <= q;               // 2'b00 and 2'b11: no rotate\n            endcase\n        end\n    end\n\nendmodule\n[DONE]"}}}
