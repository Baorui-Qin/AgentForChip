{"seq":393,"elapsed_ms":2967,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input  logic        clk,\n    input  logic        reset,\n    input  logic [7:0]  in,\n    output logic [23:0] out_bytes,\n    output logic        done\n);\n\n    typedef enum logic [1:0] {\n        IDLE  = 2'd0,\n        BYTE1 = 2'd1,\n        BYTE2 = 2'd2,\n        BYTE3 = 2'd3\n    } state_t;\n\n    state_t state;\n    logic [7:0] b1, b2, b3;\n\n    always_ff @(posedge clk) begin\n        if (reset) begin\n            state     <= IDLE;\n            done      <= 1'b0;\n            out_bytes <= 24'h000000;\n            b1        <= 8'h00;\n            b2        <= 8'h00;\n            b3        <= 8'h00;\n        end else begin\n            done <= (state == BYTE3);\n\n            case (state)\n                IDLE: begin\n                    if (in[3]) begin\n                        state <= BYTE1;\n                        b1    <= in;\n                    end\n                end\n\n                BYTE1: begin\n                    state <= BYTE2;\n                    b2    <= in;\n                end\n\n                BYTE2: begin\n                    state <= BYTE3;\n                    b3    <= in;\n                end\n\n                BYTE3: begin\n                    out_bytes <= {b1, b2, b3};\n                    if (in[3]) begin\n                        state <= BYTE1;\n                        b1    <= in;\n                    end else begin\n                        state <= IDLE;\n                    end\n                end\n\n                default: state <= IDLE;\n            endcase\n        end\n    end\n\nendmodule\n[DONE]"}}}
