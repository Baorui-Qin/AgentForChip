{"seq":232,"elapsed_ms":2218,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input  logic clk,\n    input  logic areset,\n    input  logic x,\n    output logic z\n);\n\n    typedef enum logic [1:0] {\n        A = 2'b00,\n        B = 2'b01,\n        C = 2'b10,\n        D = 2'b11\n    } state_t;\n\n    state_t state, next_state;\n\n    always_comb begin\n        case (state)\n            A: next_state = x ? B : A;\n            B: next_state = x ? C : D;\n            C: next_state = x ? C : D;\n            D: next_state = x ? C : D;\n            default: next_state = A;\n        endcase\n    end\n\n    always_ff @(posedge clk or posedge areset) begin\n        if (areset) begin\n            state <= A;\n        end else begin\n            state <= next_state;\n        end\n    end\n\n    assign z = (state == B) || (state == D);\n\nendmodule\n[DONE]"}}}
