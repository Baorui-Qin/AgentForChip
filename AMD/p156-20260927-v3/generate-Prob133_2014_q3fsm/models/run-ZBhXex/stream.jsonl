{"seq":473,"elapsed_ms":3120,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input  clk,\n    input  reset,\n    input  s,\n    input  w,\n    output z\n);\n\n    // State encoding:\n    // A  : reset/wait state\n    // B  : first w sample of a 3-cycle group\n    // C0 : after one sample, count = 0\n    // C1 : after one sample, count = 1\n    // D0 : after two samples, count = 0\n    // D1 : after two samples, count = 1\n    // D2 : after two samples, count = 2\n    // E0 : output cycle, previous group did not have exactly two ones\n    // E1 : output cycle, previous group had exactly two ones\n    localparam A  = 4'd0;\n    localparam B  = 4'd1;\n    localparam C0 = 4'd2;\n    localparam C1 = 4'd3;\n    localparam D0 = 4'd4;\n    localparam D1 = 4'd5;\n    localparam D2 = 4'd6;\n    localparam E0 = 4'd7;\n    localparam E1 = 4'd8;\n\n    reg [3:0] state, next_state;\n\n    always @(*) begin\n        case (state)\n            A:  next_state = s ? B : A;\n\n            B:  next_state = w ? C1 : C0;\n\n            C0: next_state = w ? D1 : D0;\n            C1: next_state = w ? D2 : D1;\n\n            D0: next_state = w ? E1 : E0;\n            D1: next_state = w ? E1 : E0;\n            D2: next_state = w ? E0 : E1;\n\n            E0: next_state = B;\n            E1: next_state = B;\n\n            default: next_state = A;\n        endcase\n    end\n\n    always @(posedge clk) begin\n        if (reset)\n            state <= A;\n        else\n            state <= next_state;\n    end\n\n    assign z = (state == E1);\n\nendmodule\n[DONE]"}}}
