{"seq":114,"elapsed_ms":2197,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input  clk,\n    input  reset,\n    output logic shift_ena\n);\n\n    logic [2:0] count;\n\n    always_ff @(posedge clk) begin\n        if (reset) begin\n            count <= 3'd4;\n        end else if (count != 3'd0) begin\n            count <= count - 3'd1;\n        end\n    end\n\n    assign shift_ena = (count != 3'd0);\n\nendmodule\n[DONE]"}}}
