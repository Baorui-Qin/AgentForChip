{"seq":322,"elapsed_ms":3258,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input resetn,\n    input x,\n    input y,\n    output f,\n    output g\n);\n\n    localparam [3:0] A = 4'd0,\n                     B = 4'd1,\n                     C = 4'd2,\n                     D = 4'd3,\n                     E = 4'd4,\n                     F = 4'd5,\n                     G = 4'd6,\n                     P = 4'd7,\n                     Z = 4'd8;\n\n    logic [3:0] state, next_state;\n\n    always_ff @(posedge clk) begin\n        if (!resetn)\n            state <= A;\n        else\n            state <= next_state;\n    end\n\n    always_comb begin\n        next_state = state;\n        case (state)\n            A: next_state = B;\n            B: next_state = C;\n            C: next_state = x ? D : C;\n            D: next_state = x ? D : E;\n            E: next_state = x ? F : C;\n            F: next_state = y ? P : G;\n            G: next_state = y ? P : Z;\n            P: next_state = P;\n            Z: next_state = Z;\n            default: next_state = A;\n        endcase\n    end\n\n    assign f = (state == B);\n    assign g = (state == F) || (state == G) || (state == P);\n\nendmodule\n[DONE]"}}}
