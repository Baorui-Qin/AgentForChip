{"seq":423,"elapsed_ms":2960,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input clk,\n    input in,\n    input reset,\n    output reg [7:0] out_byte,\n    output reg done\n);\n\n    localparam IDLE  = 3'd0,\n               START = 3'd1,\n               DATA  = 3'd2,\n               STOP  = 3'd3,\n               WAIT  = 3'd4;\n\n    reg [2:0] state, next_state;\n    reg [3:0] cnt;\n    reg [7:0] data;\n\n    always @(*) begin\n        case (state)\n            IDLE:  next_state = in ? IDLE : START;\n            START: next_state = DATA;\n            DATA:  next_state = (cnt == 4'd6) ? STOP : DATA;\n            STOP:  next_state = in ? IDLE : WAIT;\n            WAIT:  next_state = in ? IDLE : WAIT;\n            default: next_state = IDLE;\n        endcase\n    end\n\n    always @(posedge clk) begin\n        if (reset) begin\n            state    <= IDLE;\n            cnt      <= 4'd0;\n            data     <= 8'd0;\n            out_byte <= 8'd0;\n            done     <= 1'b0;\n        end else begin\n            state <= next_state;\n\n            case (state)\n                START: begin\n                    data[7] <= in;\n                    cnt     <= 4'd0;\n                    done    <= 1'b0;\n                end\n                DATA: begin\n                    data <= {in, data[7:1]};\n                    cnt  <= cnt + 4'd1;\n                    done <= 1'b0;\n                end\n                STOP: begin\n                    out_byte <= data;\n                    done     <= in;\n                end\n                default: begin\n                    done <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n[DONE]"}}}
