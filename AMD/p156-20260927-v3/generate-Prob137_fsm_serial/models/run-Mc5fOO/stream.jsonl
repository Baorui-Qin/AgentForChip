{"seq":298,"elapsed_ms":5972,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule (\n    input  clk,\n    input  reset,\n    input  in,\n    output done\n);\n\n    localparam IDLE  = 3'd0,\n               DATA  = 3'd1,\n               STOP  = 3'd2,\n               WAIT  = 3'd3;\n\n    reg [2:0] state, next_state;\n    reg [2:0] bit_cnt;\n\n    always @(posedge clk) begin\n        if (reset) begin\n            state   <= IDLE;\n            bit_cnt <= 3'd0;\n        end else begin\n            state <= next_state;\n\n            if (state == IDLE && in == 1'b0)\n                bit_cnt <= 3'd0;\n            else if (state == DATA)\n                bit_cnt <= bit_cnt + 3'd1;\n        end\n    end\n\n    always @(*) begin\n        case (state)\n            IDLE:  next_state = in ? IDLE : DATA;\n            DATA:  next_state = (bit_cnt == 3'd7) ? STOP : DATA;\n            STOP:  next_state = in ? IDLE : WAIT;\n            WAIT:  next_state = in ? IDLE : WAIT;\n            default: next_state = IDLE;\n        endcase\n    end\n\n    assign done = (state == STOP) && in;\n\nendmodule\n[DONE]"}}}
