{"seq":498,"elapsed_ms":3768,"chunk":{"type":"block-end","index":0,"block":{"type":"text","text":"[BEGIN]\nmodule TopModule(\n    input  logic clk,\n    input  logic reset,\n    input  logic [2:0] s,\n    output logic fr2,\n    output logic fr1,\n    output logic fr0,\n    output logic dfr\n);\n\n    logic [1:0] level;\n    logic       dfr_reg;\n\n    logic [1:0] next_level;\n    logic       next_dfr;\n\n    always_comb begin\n        if (s[2])\n            next_level = 2'd3;\n        else if (s[1])\n            next_level = 2'd2;\n        else if (s[0])\n            next_level = 2'd1;\n        else\n            next_level = 2'd0;\n\n        if (next_level == 2'd0)\n            next_dfr = 1'b1;\n        else if (next_level == 2'd3)\n            next_dfr = 1'b0;\n        else if (next_level == level)\n            next_dfr = dfr_reg;\n        else if (next_level > level)\n            next_dfr = 1'b1;\n        else\n            next_dfr = 1'b0;\n    end\n\n    always_ff @(posedge clk) begin\n        if (reset) begin\n            level   <= 2'd0;\n            dfr_reg <= 1'b1;\n        end else begin\n            level   <= next_level;\n            dfr_reg <= next_dfr;\n        end\n    end\n\n    always_comb begin\n        case (level)\n            2'd0: begin\n                fr2 = 1'b1;\n                fr1 = 1'b1;\n                fr0 = 1'b1;\n            end\n            2'd1: begin\n                fr2 = 1'b0;\n                fr1 = 1'b1;\n                fr0 = 1'b1;\n            end\n            2'd2: begin\n                fr2 = 1'b0;\n                fr1 = 1'b0;\n                fr0 = 1'b1;\n            end\n            default: begin\n                fr2 = 1'b0;\n                fr1 = 1'b0;\n                fr0 = 1'b0;\n            end\n        endcase\n        dfr = dfr_reg;\n    end\n\nendmodule\n[DONE]"}}}
