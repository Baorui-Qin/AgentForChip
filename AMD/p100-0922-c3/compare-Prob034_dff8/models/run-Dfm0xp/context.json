    "source": "\nmodule TopModule (\n    input  logic       clk,\n    input  logic [7:0] d,\n    output logic [7:0] q\n);\n\n    initial q = 8'h00;\n\n    always @(posedge clk) begin\n        q <= d;\n    end\n\nendmodule\n"
