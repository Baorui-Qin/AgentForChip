  "task": {
    "id": "Prob034_dff8",
    "spec": "\r\nI would like you to implement a module named TopModule with the following\r\ninterface. All input and output ports are one bit unless otherwise\r\nspecified.\r\n\r\n - input  clk\r\n - input  d   (8 bits)\r\n - output q   (8 bits)\r\n\r\nThe module should include 8 D flip-flops. All DFFs should be triggered by\r\nthe positive edge of clock.\r\n\r\n",
    "interface": {
      "top": "TopModule",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false
        },
        {
          "name": "d",
          "direction": "input",
          "width": 8,
          "signed": false
        },
        {
          "name": "q",
          "direction": "output",
          "width": 8,
          "signed": false
        }
      ]
    },
    "constraints": "SystemVerilog, single self-contained TopModule DUT; xczu3eg-sbva484-1-e; 5 ns synthesis clock; simulator seed 1. No reference dependencies, hierarchy outside the DUT, file access, includes or DPI."
  },
  "sample_id": "c6db6801-509e-4d4b-9b10-f6fd69ca262b",
  "variant_id": "C",
  "current": {
    "revision_id": "27cac37b-9e8c-4b2a-bb1d-d2a8d4dcb606",
    "source_sha256": "7533b44c970613b4df013fc6860ab8cfd42382e027ec3b4174e8e07bf49944c8",
    "source": "\nmodule TopModule (\n    input  logic       clk,\n    input  logic [7:0] d,\n    output logic [7:0] q\n);\n\n    always @(posedge clk) begin\n        q <= d;\n    end\n\nendmodule\n"
  },
