// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`retains startup delay and makes missing checks and unobserved bits fatal, with a retained waveform 1`] = `
"module netlist_tb;
integer checks=0,mismatches=0; reg seen=0;
TopModule dut();
initial begin #101;  end
final begin
if(!seen) $fatal(1,"NETLIST_OUTPUT_UNOBSERVED:out");
if(checks != 2) $fatal(1,"RTL_CHECK_COUNT_CHANGED");
$display("Mismatches: %0d in %0d samples",mismatches,checks);
end

initial begin $timeformat(-12,0,"",0); $dumpfile("wave.vcd"); $dumpvars(1,netlist_tb); $dumpvars(1,netlist_tb.dut); end
always @(mismatches) if(mismatches==1) $display("RTL_FIRST_MISMATCH time_ps=%0t checks=%0d",$time,checks);
endmodule
"
`;
