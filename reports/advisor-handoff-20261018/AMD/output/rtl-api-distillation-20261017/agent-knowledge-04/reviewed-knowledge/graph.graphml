d">{&quot;id&quot;:&quot;r04:Q083:api:003:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\003\\receipt.json&quot;,&quot;sha256&quot;:&quot;99acc3362f40ccd1b2ea7724893f734e6a21002b386f7aab140727acff567c2b&quot;}}</data></node><node id="r04:call_00_EAHbogtejVj8Juss8ZDJ8036"><data key="record">{&quot;id&quot;:&quot;r04:call_00_EAHbogtejVj8Juss8ZDJ8036&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\003\\response.json&quot;,&quot;sha256&quot;:&quot;a491929e205bb075ac47cbaf3d60bd69ee04b49483fff8a4b103951e4dc1a429&quot;},&quot;name&quot;:&quot;write_file&quot;,&quot;arguments&quot;:&quot;{\&quot;path\&quot;: \&quot;dut.sv\&quot;, \&quot;content\&quot;: \&quot;module top_module #(\\n    parameter DEPTH = 3,\\n    parameter AW    = (DEPTH &lt;= 1 ? 1 : $clog2(DEPTH)),\\n    parameter CW    = $clog2(DEPTH + 1)\\n) (\\n    input  logic        clk,\\n    input  logic        rst,\\n    input  logic        s_valid,\\n    input  logic [7:0]  s_data,\\n    output logic        s_ready,\\n    output logic        m_valid,\\n    output logic [7:0]  m_data,\\n    input  logic        m_ready,\\n    output logic [CW-1:0] count\\n);\\n\\n    logic [7:0] mem [0:DEPTH-1];\\n    logic [AW-1:0] wptr, rptr;\\n    logic [CW-1:0] cnt;\\n\\n    // Accepted transfers\\n    wire push = s_valid &amp;&amp; s_ready;\\n    wire pop  = m_valid &amp;&amp; m_ready;\\n\\n    // Occupancy\\n    assign count   = cnt;\\n    assign m_valid = (cnt != 0);\\n    assign m_data  = m_valid ? mem[rptr] : 8&apos;d0;\\n\\n    // Ready: room exists, or a full slot is being freed by a pop this cycle.\\n    assign s_ready = (cnt &lt; DEPTH) || (m_valid &amp;&amp; m_ready);\\n\\n    always_ff @(posedge clk) begin\\n        if (rst) begin\\n            wptr &lt;= &apos;0;\\n            rptr &lt;= &apos;0;\\n            cnt  &lt;= &apos;0;\\n        end else begin\\n            if (push) begin\\n                mem[wptr] &lt;= s_data;\\n                wptr &lt;= (wptr == AW&apos;(DEPTH - 1)) ? &apos;0 : wptr + 1&apos;b1;\\n            end\\n            if (pop) begin\\n                rptr &lt;= (rptr == AW&apos;(DEPTH - 1)) ? &apos;0 : rptr + 1&apos;b1;\\n            end\\n            if (push &amp;&amp; !pop)      cnt &lt;= cnt + 1&apos;b1;\\n            else if (!push &amp;&amp; pop) cnt &lt;= cnt - 1&apos;b1;\\n        end\\n    end\\n\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q083:api:004"><data key="record">{&quot;id&quot;:&quot;r04:Q083:api:004&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\004\\request.json&quot;,&quot;sha256&quot;:&quot;9a31f4ed0446edd1ac82365d6339f87cbbcc49186930c12343f222bdee505041&quot;}}</data></node><node id="r04:Q083:api:004:response"><data key="record">{&quot;id&quot;:&quot;r04:Q083:api:004:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;4d5049afd517a8eb6d42366a819510cd3bd29a83dd70017315d8f25452c8c02c&quot;}}</data></node><node id="r04:Q083:api:004:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q083:api:004:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\004\\receipt.json&quot;,&quot;sha256&quot;:&quot;77b369b5ef122a35f6e2a8d3004850b029e305da98c0801dcd2999a133de3c34&quot;}}</data></node><node id="r04:call_00_K0sOERR7IjQ5jI6VTbxu9581"><data key="record">{&quot;id&quot;:&quot;r04:call_00_K0sOERR7IjQ5jI6VTbxu9581&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;4d5049afd517a8eb6d42366a819510cd3bd29a83dd70017315d8f25452c8c02c&quot;},&quot;name&quot;:&quot;write_file&quot;,&quot;arguments&quot;:&quot;{\&quot;content\&quot;: \&quot;module tb(output reg done);\\n    localparam DEPTH = 3;\\n    localparam AW = (DEPTH &lt;= 1 ? 1 : $clog2(DEPTH));\\n    localparam CW = $clog2(DEPTH + 1);\\n\\n    reg clk = 0, rst = 0;\\n    reg s_valid = 0;\\n    reg [7:0] s_data = 0;\\n    reg m_ready = 0;\\n    wire s_ready, m_valid;\\n    wire [7:0] m_data;\\n    wire [CW-1:0] count;\\n\\n    top_module #(.DEPTH(DEPTH)) dut (\\n        .clk(clk), .rst(rst), .s_valid(s_valid), .s_data(s_data),\\n        .s_ready(s_ready), .m_valid(m_valid), .m_data(m_data),\\n        .m_ready(m_ready), .count(count)\\n    );\\n\\n    always #5 clk = ~clk;\\n\\n    integer errors = 0;\\n    integer i;\\n\\n    task check(input int cond, input string msg);\\n        if (!cond) begin\\n            $display(\\\&quot;FAIL: %s\\\&quot;, msg);\\n            errors = errors + 1;\\n        end\\n    endtask\\n\\n    initial begin\\n        // reset\\n        rst = 1;\\n        repeat (2) @(negedge clk);\\n        rst = 0;\\n        @(negedge clk);\\n        check(count == 0, \\\&quot;count after reset\\\&quot;);\\n        check(m_valid == 0, \\\&quot;m_valid after reset\\\&quot;);\\n        check(m_data == 0, \\\&quot;m_data empty\\\&quot;);\\n        check(s_ready == 1, \\\&quot;s_ready empty\\\&quot;);\\n\\n        // push 3 items\\n        for (i = 0; i &lt; 3; i = i + 1) begin\\n            s_valid = 1; s_data = 8&apos;h10 + i;\\n            @(negedge clk);\\n            check(s_ready == 1, \\\&quot;s_ready during push\\\&quot;);\\n        end\\n        s_valid = 0;\\n        @(negedge clk);\\n        check(count == 3, \\\&quot;count full\\\&quot;);\\n        check(m_valid == 1, \\\&quot;m_valid full\\\&quot;);\\n        check(m_data == 8&apos;h10, \\\&quot;head data\\\&quot;);\\n\\n        // full: s_ready low when no pop\\n        check(s_ready == 0, \\\&quot;s_ready full no pop\\\&quot;);\\n\\n        // full replacement: pop + push same cycle\\n        m_ready = 1; s_valid = 1; s_data = 8&apos;hAA;\\n        @(negedge clk);\\n        check(s_ready == 1, \\\&quot;s_ready full with pop\\\&quot;);\\n        // after edge: head should be 0x11 (old head retired), count still 3\\n        check(count == 3, \\\&quot;count after replacement\\\&quot;);\\n        check(m_data == 8&apos;h11, \\\&quot;head after replacement\\\&quot;);\\n        m_ready = 0; s_valid = 0;\\n        @(negedge clk);\\n\\n        // drain\\n        m_ready = 1;\\n        @(negedge clk);\\n        check(m_data == 8&apos;h12, \\\&quot;drain 2\\\&quot;);\\n        @(negedge clk);\\n        check(m_data == 8&apos;hAA, \\\&quot;drain replacement data\\\&quot;);\\n        @(negedge clk);\\n        check(count == 0, \\\&quot;count empty after drain\\\&quot;);\\n        check(m_valid == 0, \\\&quot;m_valid empty\\\&quot;);\\n        check(m_data == 0, \\\&quot;m_data empty\\\&quot;);\\n        m_ready = 0;\\n\\n        if (errors == 0) $display(\\\&quot;PASS\\\&quot;);\\n        else $display(\\\&quot;FAILED with %0d errors\\\&quot;, errors);\\n        done = 1;\\n        if (errors != 0) $fatal(1, \\\&quot;diagnostic failed\\\&quot;);\\n    end\\nendmodule\\n\&quot;, \&quot;path\&quot;: \&quot;diag_tb.sv\&quot;}&quot;}</data></node><node id="r04:Q083:api:005"><data key="record">{&quot;id&quot;:&quot;r04:Q083:api:005&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\005\\request.json&quot;,&quot;sha256&quot;:&quot;e1c515b91274413a00ee139bf4be4eca293eeea82459b63b64e