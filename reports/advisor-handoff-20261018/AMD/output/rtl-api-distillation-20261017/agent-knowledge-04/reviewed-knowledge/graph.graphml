n            errors = errors + 1;\\n        end\\n    endtask\\n\\n    initial begin\\n        // reset\\n        rst = 1;\\n        repeat (2) @(negedge clk);\\n        rst = 0;\\n        @(negedge clk);\\n        check(count == 0, \\\&quot;count after reset\\\&quot;);\\n        check(m_valid == 0, \\\&quot;m_valid after reset\\\&quot;);\\n        check(m_data == 0, \\\&quot;m_data empty\\\&quot;);\\n        check(s_ready == 1, \\\&quot;s_ready empty\\\&quot;);\\n\\n        // push 3 items\\n        for (i = 0; i &lt; 3; i = i + 1) begin\\n            s_valid = 1; s_data = 8&apos;h10 + i;\\n            @(negedge clk);\\n            check(s_ready == 1, \\\&quot;s_ready during push\\\&quot;);\\n        end\\n        s_valid = 0;\\n        @(negedge clk);\\n        check(count == 3, \\\&quot;count full\\\&quot;);\\n        check(m_valid == 1, \\\&quot;m_valid full\\\&quot;);\\n        check(m_data == 8&apos;h10, \\\&quot;head data\\\&quot;);\\n\\n        // full: s_ready low when no pop\\n        check(s_ready == 0, \\\&quot;s_ready full no pop\\\&quot;);\\n\\n        // full replacement: pop + push same cycle\\n        m_ready = 1; s_valid = 1; s_data = 8&apos;hAA;\\n        @(negedge clk);\\n        check(s_ready == 1, \\\&quot;s_ready full with pop\\\&quot;);\\n        // after edge: head should be 0x11 (old head retired), count still 3\\n        check(count == 3, \\\&quot;count after replacement\\\&quot;);\\n        check(m_data == 8&apos;h11, \\\&quot;head after replacement\\\&quot;);\\n        m_ready = 0; s_valid = 0;\\n        @(negedge clk);\\n\\n        // drain\\n        m_ready = 1;\\n        @(negedge clk);\\n        check(m_data == 8&apos;h12, \\\&quot;drain 2\\\&quot;);\\n        @(negedge clk);\\n        check(m_data == 8&apos;hAA, \\\&quot;drain replacement data\\\&quot;);\\n        @(negedge clk);\\n        check(count == 0, \\\&quot;count empty after drain\\\&quot;);\\n        check(m_valid == 0, \\\&quot;m_valid empty\\\&quot;);\\n        check(m_data == 0, \\\&quot;m_data empty\\\&quot;);\\n        m_ready = 0;\\n\\n        if (errors == 0) $display(\\\&quot;PASS\\\&quot;);\\n        else $display(\\\&quot;FAILED with %0d errors\\\&quot;, errors);\\n        done = 1;\\n        if (errors != 0) $fatal(1, \\\&quot;diagnostic failed\\\&quot;);\\n    end\\nendmodule\\n\&quot;, \&quot;path\&quot;: \&quot;diag_tb.sv\&quot;}&quot;}</data></node><node id="r04:Q083:api:007"><data key="record">{&quot;id&quot;:&quot;r04:Q083:api:007&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\007\\request.json&quot;,&quot;sha256&quot;:&quot;e9f975f86ece31503b5e14154af94539117fb213f6cbe82cdf3b278a97d70fe9&quot;}}</data></node><node id="r04:Q083:api:007:response"><data key="record">{&quot;id&quot;:&quot;r04:Q083:api:007:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\007\\response.json&quot;,&quot;sha256&quot;:&quot;962c855fc79ff3fc0620f51c44a95f09c8406906a2c74d6190045f0045acaf37&quot;}}</data></node><node id="r04:Q083:api:007:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q083:api:007:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\007\\receipt.json&quot;,&quot;sha256&quot;:&quot;68f57a5186bd7a01ffd2298fb9edfd434cda06f7f17f1bb45283225bfe259839&quot;}}</data></node><node id="r04:call_00_6mUPvXi5NL45g9ZLqI2U5853"><data key="record">{&quot;id&quot;:&quot;r04:call_00_6mUPvXi5NL45g9ZLqI2U5853&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q083\\api\\007\\response.json&quot;,&quot;s