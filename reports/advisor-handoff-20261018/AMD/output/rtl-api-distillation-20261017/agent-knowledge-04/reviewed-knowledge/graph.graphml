n        // push 4, pop 4, verify order\\n        wpush(8&apos;h11);\\n        wpush(8&apos;h22);\\n        wpush(8&apos;h33);\\n        wpush(8&apos;h44);\\n        rpop(8&apos;h11);\\n        rpop(8&apos;h22);\\n        rpop(8&apos;h33);\\n        rpop(8&apos;h44);\\n\\n        // wrap test: push 6, pop 6\\n        wpush(8&apos;hA1);\\n        wpush(8&apos;hA2);\\n        wpush(8&apos;hA3);\\n        wpush(8&apos;hA4);\\n        wpush(8&apos;hA5);\\n        wpush(8&apos;hA6);\\n        rpop(8&apos;hA1);\\n        rpop(8&apos;hA2);\\n        rpop(8&apos;hA3);\\n        rpop(8&apos;hA4);\\n        rpop(8&apos;hA5);\\n        rpop(8&apos;hA6);\\n\\n        // full/empty boundary: fill to full, verify wready drops\\n        wpush(8&apos;hB1);\\n        wpush(8&apos;hB2);\\n        wpush(8&apos;hB3);\\n        wpush(8&apos;hB4);\\n        // now full; wready should be 0\\n        repeat (3) @(posedge wclk);\\n        if (wready !== 0) $fatal(1, \\\&quot;wready not 0 when full\\\&quot;);\\n        // drain\\n        rpop(8&apos;hB1);\\n        rpop(8&apos;hB2);\\n        rpop(8&apos;hB3);\\n        rpop(8&apos;hB4);\\n\\n        repeat (3) @(posedge rclk);\\n        if (rvalid !== 0) $fatal(1, \\\&quot;rvalid not 0 after drain\\\&quot;);\\n\\n        $display(\\\&quot;PASS: wcnt=%0d rcnt=%0d\\\&quot;, wcnt, rcnt);\\n        done = 1;\\n    end\\n\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q123:api:011"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:011&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\011\\request.json&quot;,&quot;sha256&quot;:&quot;f2b070de86ae2d334074517f0c2968f18e6fdd5c4c0f93a0c7c7410a91b2d345&quot;}}</data></node><node id="r04:Q123:api:011:response"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:011:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quo