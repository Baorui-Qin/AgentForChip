low, change upstream data, and assert output data stays stable; verify accepted-event counts and same-edge turnover separately.\\\&quot;,\\\&quot;caveat\\\&quot;:\\\&quot;Reset may cancel a pending transaction per contract; a passing test is finite evidence, not proof.\\\&quot;}],\\\&quot;change_operations\\\&quot;:[\\\&quot;002\\\&quot;,\\\&quot;003\\\&quot;],\\\&quot;verification_operations\\\&quot;:[\\\&quot;004\\\&quot;,\\\&quot;005\\\&quot;]}\&quot;}&quot;}</data></node><node id="r04:Q114:api:008"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:008&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\008\\request.json&quot;,&quot;sha256&quot;:&quot;f177f0d10a1677c143d5196435aa9be407113b42ab1a8247a8b1e36e5e917618&quot;}}</data></node><node id="r04:Q114:api:008:response"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:008:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\008\\response.json&quot;,&quot;sha256&quot;:&quot;13cc2ca71a6ba705c9fc4847cc977b07d70021770e503b6d8bbf413ac6534781&quot;}}</data></node><node id="r04:Q114:api:008:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:008:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\008\\receipt.json&quot;,&quot;sha256&quot;:&quot;ab35ece9d2f97ca47cf5a474eca3795c4346eb384f4785c6245b3db609cfd65d&quot;}}</data></node><node id="r04:call_00_E5mUTDJvQdRkZkgy23wU4899"><data key="record">{&quot;id&quot;:&quot;r04:call_00_E5mUTDJvQdRkZkgy23wU4899&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation