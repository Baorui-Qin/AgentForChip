sh&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\003\\receipt.json&quot;,&quot;sha256&quot;:&quot;4110b3902e80049fa2726116389796682cb7d8b6d4d60714a6d94ad7d2e540de&quot;}}</data></node><node id="r04:call_00_cVGDLzENNcT4xfdXHAQg1281"><data key="record">{&quot;id&quot;:&quot;r04:call_00_cVGDLzENNcT4xfdXHAQg1281&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\003\\response.json&quot;,&quot;sha256&quot;:&quot;78614baf772d51790eab57e92d273a6bd33ea4a35328cd5c7ae9c56e54090a52&quot;},&quot;name&quot;:&quot;write_file&quot;,&quot;arguments&quot;:&quot;{\&quot;path\&quot;: \&quot;dut.sv\&quot;, \&quot;content\&quot;: \&quot;module top_module (\\n    input  logic       wclk,\\n    input  logic       wrst_n,\\n    input  logic       wvalid,\\n    input  logic [7:0] wdata,\\n    output logic       wready,\\n    input  logic       rclk,\\n    input  logic       rrst_n,\\n    input  logic       rready,\\n    output logic       rvalid,\\n    output logic [7:0] rdata\\n);\\n\\n    // ============================================================\\n    // 写时钟域信号\\n    // ============================================================\\n    logic [1:0] wptr_bin;        // 写指针（二进制，2位，容量4）\\n    logic [2:0] wptr_gray;       // 写指针（格雷码，3位）\\n    logic [2:0] wptr_gray_sync;  // 写指针格雷码同步到读时钟域\\n    logic [2:0] rptr_gray_sync;  // 读指针格雷码同步到写时钟域\\n\\n    // ============================================================\\n    // 读时钟域信号\\n    // ============================================================\\n    logic [1:0] rptr_bin;        // 读指针（二进制，2位）\\n    logic [2:0] rptr_gray;       // 读指针（格雷码，3位）\\n\\n    // ============================================================\\n    // 存储阵列\\n    // ============================================================\\n    logic [7:0] mem [0:3];\\n\\n    // ============================================================\\n    // 复位同步释放\\n    // ============================================================\\n    logic wrst_n_sync;\\n    logic rrst_n_sync;\\n\\n    // 写时钟域复位同步释放\\n    always_ff @(posedge wclk or negedge wrst_n) begin\\n        if (!wrst_n)\\n            wrst_n_sync &lt;= 1&apos;b0;\\n        else\\n            wrst_n_sync &lt;= 1&apos;b1;\\n    end\\n\\n    // 读时钟域复位同步释放\\n    always_ff @(posedge rclk or negedge rrst_n) begin\\n        if (!rrst_n)\\n            rrst_n_sync &lt;= 1&apos;b0;\\n        else\\n            rrst_n_sync &lt;= 1&apos;b1;\\n    end\\n\\n    // ============================================================\\n    // 写指针逻辑\\n    // ============================================================\\n    always_ff @(posedge wclk or negedge wrst_n) begin\\n        if (!wrst_n) begin\\n            wptr_bin &lt;= 2&apos;b00;\\n        end else if (wvalid &amp;&amp; wready) begin\\n            wptr_bin &lt;= wptr_bin + 2&apos;b01;\\n        end\\n    end\\n\\n    // 二进制转格雷码\\n    assign wptr_gray = {wptr_bin[1], wptr_bin[1] ^ wptr_bin[0], wptr_bin[0]};\\n\\n    // ============================================================\\n    // 读指针逻辑\\n    // ============================================================\\n    always_ff @(posedge rclk or negedge rrst_n) begin\\n        if (!rrst_n) begin\\n            rptr_bin &lt;= 2&apos;b00;\\n        end else if (rvalid &amp;&amp; rready) begin\\n            rptr_bin &lt;= rptr_bin + 2&apos;b01;\\n        end\\n    end\\n\\n    // 二进制转格雷码\\n    assign rptr_gray = {rptr_bin[1], rptr_bin[1] ^ rptr_bin[0], rptr_bin[0]};\\n\\n    // ============================================================\\n    // 跨时钟域同步（两级同步器）\\n    // ============================================================\\n\\n    // 写指针格雷码同步到读时钟域\\n    logic [2:0] wptr_gray_sync_1;\\n    always_ff @(posedge rclk or negedge rrst_n) begin\\n        if (!rrst_n) begin\\n            wptr_gray_sync_1 &lt;= 3&apos;b000;\\n            wptr_gray_sync   &lt;= 3&apos;b000;\\n        end else begin\\n            wptr_gray_sync_1 &lt;= wptr_gray;\\n            wptr_gray_sync   &lt;= wptr_gray_sync_1;\\n        end\\n    end\\n\\n    // 读指针格雷码同步到写时钟域\\n    logic [2:0] rptr_gray_sync_1;\\n    always_ff @(posedge wclk or negedge wrst_n) begin\\n        if (!wrst_n) begin\\n            rptr_gray_sync_1 &lt;= 3&apos;b000;\\n            rptr_gray_sync   &lt;= 3&apos;b000;\\n        end else begin\\n            rptr_gray_sync_1 &lt;= rptr_gray;\\n            rptr_gray_sync   &lt;= rptr_gray_sync_1;\\n        end\\n    end\\n\\n    // ============================================================\\n    // 满/空判断\\n    // ============================================================\\n    logic wfull;\\n    logic rempty;\\n\\n    // 写满：写指针和读指针（同步后）格雷码最高两位相反，其余位相同\\n    assign wfull = (wptr_gray[2] != rptr_gray_sync[2]) &amp;&amp;\\n                   (wptr_gray[1] != rptr_gray_sync[1]) &amp;&amp;\\n                   (wptr_gray[0] == rptr_gray_sync[0]);\\n\\n    // 读空：写指针和读指针（同步后）格雷码完全相同\\n    assign rempty = (wptr_gray_sync == rptr_gray);\\n\\n    // ============================================================\\n    // 输出信号\\n    // ============================================================\\n    assign wready = !wfull &amp;&amp; wrst_n_sync;\\n    assign rvalid = !rempty &amp;&amp; rrst_n_sync;\\n\\n    // 读数据：非空时输出队首数据，空时输出0\\n    always_comb begin\\n        if (rvalid)\\n            rdata = mem[rptr_bin];\\n        else\\n            rdata = 8&apos;b0;\\n    end\\n\\n    // ============================================================\\n    // 写数据存储\\n    // ============================================================\\n    always_ff @(posedge wclk) begin\\n        if (wvalid &amp;&amp; wready) begin\\n            mem[wptr_bin] &lt;= wdata;\\n        end\\n    end\\n\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q123:api:004"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:004&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\004\\request.json&quot;,&quot;sha256&quot;:&quot;69c692af87c74a5e423480f29c057ef1d411c5ad85caae97ab6c9c730588fecd&quot;}}</data></node><node id="r04:Q123:api:004:response"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:004:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;ad86080ef0d88476c3e4fd2492891b7348e092f0f1e0edeab2a6e4815ec076c7&quot;}}</data></node><node id="r04:Q123:api:004:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:004:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\004\\receipt.json&quot;,&quot;sha256&quot;:&quot;ccc9b4d1b393dbb1e4af76d3927b2399c3325bcf9804e787d788d69e4a81a716&quot;}}</data></node><node id="r04:call_00_7ghPZb4kzRy2tBrwiXt92489"><data key="record">{&quot;id&quot;:&quot;r04:call_00_7ghPZb4kzRy2tBrwiXt92489&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;ad86080ef0d88476c3e4fd2492891b7348e092f0f1e0edeab2a6e4815ec076c7&quot;},&quot;name&quot;:&quot;evaluate_rtl&quot;,&quot;arguments&quot;:&quot;{}&quot;}</data></node><node id="r04:Q123:api:005"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:005&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\005\\request.json&quot;,&quot;sha256&quot;:&quot;06740f542932fc2033e48693eecd013813ed20bea2816527f9b05f0450a45e19&quot;}}</data></node><node id="r04:Q123:api:005:response"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:005:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\005\\response.json&quot;,&quot;sha256&quot;:&quot;8c806c96d442f5dbd1119a553b61518ff41d94beb860aeef429d482eff76096d&quot;}}</data></node><node id="r04:Q123:api:005:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:005:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\005\\receipt.json&quot;,&quot;sha256&quot;:&quot;90811500da24e0b9d710b51d6754ed1a161ec54f17b837e19c0c6ca88a2d5f08&quot;}}</data></node><node id="r04:call_00_1ihdKHeb45jauchuZ9bb1001"><data key="record">{&quot;id&quot;:&quot;r04:call_00_1ihdKHeb45jauchuZ9bb1001&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\005\\response.json&quot;,&quot;sha256&quot;:&quot;8c806c96d442f5dbd1119a553b61518ff41d94beb860aeef429d482eff76096d&quot;},&quot;name&quot;:&quot;write_file&quot;,&quot;arguments&quot;:&quot;{\&quot;path\&quot;: \&quot;diag_tb.sv\&quot;, \&quot;content\&quot;: \&quot;module tb(output reg done);\\n\\n    logic wclk, wrst_n, wvalid, wready;\\n    logic [7:0] wdata;\\n    logic rclk, rrst_n, rready, rvalid;\\n    logic [7:0] rdata;\\n\\n    top_module dut (\\n        .wclk(wclk), .wrst_n(wrst_n), .wvalid(wvalid), .wdata(wdata), .wready(wready),\\n        .rclk(rclk), .rrst_n(rrst_n), .rready(rready), .rvalid(rvalid), .rdata(rdata)\\n    );\\n\\n    // independent clocks\\n    initial wclk = 0;\\n    always #5 wclk = ~wclk;   // 100MHz\\n    initial rclk = 0;\\n    always #7 rclk = ~rclk;   // ~71MHz\\n\\n    // scoreboard\\n    logic [7:0] q[$];\\n    int wcnt, rcnt;\\n\\n    task automatic wpush(input [7:0] d);\\n        wvalid &lt;= 1; wdata &lt;= d;\\n        // wait until accepted (pre-edge wvalid&amp;&amp;wready)\\n        do @(posedge wclk); while (!(wvalid &amp;&amp; wready));\\n        wvalid &lt;= 0;\\n        q.push_back(d);\\n        wcnt++;\\n    endtask\\n\\n    task automatic rpop(input [7:0] exp);\\n        rready &lt;= 1;\\n        do @(posedge rclk); while (!(rvalid &amp;&amp; rready));\\n        rready &lt;= 0;\\n        if (rdata !== exp) begin\\n            $display(\\\&quot;FAIL: rdata=%h exp=%h\\\&quot;, rdata, exp);\\n            $fatal(1, \\\&quot;data mismatch\\\&quot;);\\n        end\\n        rcnt++;\\n    endtask\\n\\n    initial begin\\n        done = 0;\\n        wvalid = 0; wdata = 0; rready = 0;\\n        wrst_n = 0; rrst_n = 0;\\n        repeat (5) @(posedge wclk);\\n        repeat (5) @(posedge rclk);\\n        wrst_n = 1; rrst_n = 1;\\n        // wait for sync release\\n        repeat (5) @(posedge wclk);\\n        repeat (5) @(posedge rclk);\\n\\n        // empty check\\n        if (rvalid !== 0) $fatal(1, \\\&quot;rvalid not 0 after reset\\\&quot;);\\n        if (rdata !== 0) $fatal(1, \\\&quot;rdata not 0 when empty\\\&quot;);\\n\\n        // push 4, pop 4, verify order\\n        wpush(8&apos;h11);\\n        wpush(8&apos;h22);\\n        wpush(8&apos;h33);\\n        wpush(8&apos;h44);\\n        rpop(8&apos;h11);\\n        rpop(8&apos;h22);\\n        rpop(8&apos;h33);\\n        rpop(8&apos;h44);\\n\\n        // wrap test: push 6, pop 6\\n        wpush(8&apos;hA1);\\n        wpush(8&apos;hA2);\\n        wpush(8&apos;hA3);\\n        wpush(8&apos;hA4);\\n        wpush(8&apos;hA5);\\n        wpush(8&apos;hA6);\\n        rpop(8&apos;hA1);\\n        rpop(8&apos;hA2);\\n        rpop(8&apos;hA3);\\n        rpop(8&apos;hA4);\\n        rpop(8&apos;hA5);\\n        rpop(8&apos;hA6);\\n\\n        // full/empty boundary: fill to full, verify wready drops\\n        wpush(8&apos;hB1);\\n        wpush(8&apos;hB2);\\n        wpush(8&apos;hB3);\\n        wpush(8&apos;hB4);\\n        // now full; wready should be 0\\n        repeat (3) @(posedge wclk);\\n        if (wready !== 0) $fatal(1, \\\&quot;wready not 0 when full\\\&quot;);\\n        // drain\\n        rpop(8&apos;hB1);\\n        rpop(8&apos;hB2);\\n        rpop(8&apos;hB3);\\n        rpop(8&apos;hB4);\\n\\n        repeat (3) @(posedge rclk);\\n        if (rvalid !== 0) $fatal(1, \\\&quot;rvalid not 0 after drain\\\&quot;);\\n\\n        $display(\\\&quot;PASS: wcnt=%0d rcnt=%0d\\\&quot;, wcnt, rcnt);\\n        done = 1;\\n    end\\n\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q123:api:006"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:006&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\006\\request.json&quot;,&quot;sha256&quot;:&quot;9a5b44f4f4942460e1f39e217a910a53503ed1d51ffae532a281097ae904dac2&quot;}}</data></node><node id="r04:Q123:api:006:response"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:006:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\006\\response.json&quot;,&quot;sha256&quot;:&quot;04627d237ca8dcd5232a1bb858b7b07cd51d8ac1730af89d627c1b4a796737a7&quot;}}</data></node><node id="r04:Q123:api:006:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q123:api:006:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q123\\api\\006\\receipt.json&quot;,&quot;sha256&quot;:&quot;eedd6c964d295871