FQy2MhuTO143X2M9678&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\002\\response.json&quot;,&quot;sha256&quot;:&quot;a226a7ae789181b00dfaa64b0f9a903c99d89476a54a4f70884a0c31f7c29245&quot;},&quot;name&quot;:&quot;lookup_knowledge&quot;,&quot;arguments&quot;:&quot;{\&quot;query\&quot;: \&quot;single-slot buffer valid data overwrite when blocked ready handshake\&quot;}&quot;}</data></node><node id="r04:Q114:api:003"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:003&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\003\\request.json&quot;,&quot;sha256&quot;:&quot;54328eeeeae29ed315b11016ba39d14fc8b92322c4eae83ed3035d1f6f0ad23d&quot;}}</data></node><node id="r04:Q114:api:003:response"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:003:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\003\\response.json&quot;,&quot;sha256&quot;:&quot;3806dd62e2374185d90d00cfbc2f50e6d5c5ac3ba1b79e33667a2fea94665f6d&quot;}}</data></node><node id="r04:Q114:api:003:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:003:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\003\\receipt.json&quot;,&quot;sha256&quot;:&quot;3d6be5ab91ba5d614eeb1d0244c55adb3cb8cee93218a0e70e7e73c7bb3decab&quot;}}</data></node><node id="r04:call_00_NRt6YxOF335HUYpLhmYp3125"><data key="record">{&quot;id&quot;:&quot;r04:call_00_NRt6YxOF335HUYpLhmYp3125&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\003\\response.json&quot;,&quot;sha256&quot;:&quot;3806dd62e2374185d90d00cfbc2f50e6d5c5ac3ba1b79e33667a2fea94665f6d&quot;},&quot;name&quot;:&quot;write_file&quot;,&quot;arguments&quot;:&quot;{\&quot;path\&quot;: \&quot;dut.sv\&quot;, \&quot;content\&quot;: \&quot;module top_module (\\n    input  clk, rst, s_valid,\\n    input  [7:0] s_data,\\n    output s_ready,\\n    output reg m_valid,\\n    output reg [7:0] m_data,\\n    input  m_ready\\n);\\n    assign s_ready = !m_valid || m_ready;\\n\\n    always @(posedge clk) begin\\n        if (rst) begin\\n            m_valid &lt;= 1&apos;b0;\\n            m_data  &lt;= 8&apos;d0;\\n        end else begin\\n            if (s_valid &amp;&amp; s_ready) begin\\n                m_valid &lt;= 1&apos;b1;\\n                m_data  &lt;= s_data;\\n            end else if (m_ready) begin\\n                m_valid &lt;= 1&apos;b0;\\n            end\\n        end\\n    end\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q114:api:004"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:004&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\004\\request.json&quot;,&quot;sha256&quot;:&quot;760534310ecaa674d26f59a844040260e40177171bf85ee0c7c41454b2de409c&quot;}}</data></node><node id="r04:Q114:api:004:response"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:004:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;015d7a3362b3a3543efdfe16c87212453596a9360d3c258894d57622f31bfc12&quot;}}</data></node><node id="r04:Q114:api:004:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:004:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\004\\receipt.json&quot;,&quot;sha256&quot;:&quot;02754f64fe44d771056396de6a0542697d96f850753da514d85af892e3794310&quot;}}</data></node><node id="r04:call_00_OSuaMBnpRrpUO4uBx34u8193"><data key="record">{&quot;id&quot;:&quot;r04:call_00_OSuaMBnpRrpUO4uBx34u8193&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;015d7a3362b3a3543efdfe16c87212453596a9360d3c258894d57622f31bfc12&quot;},&quot;name&quot;:&quot;write_file&quot;,&quot;arguments&quot;:&quot;{\&quot;path\&quot;: \&quot;diag_tb.sv\&quot;, \&quot;content\&quot;: \&quot;module tb(output reg done);\\n    reg clk, rst, s_valid, m_ready;\\n    reg [7:0] s_data;\\n    wire s_ready;\\n    wire m_valid;\\n    wire [7:0] m_data;\\n\\n    top_module dut (\\n        .clk(clk), .rst(rst),\\n        .s_valid(s_valid), .s_data(s_data), .s_ready(s_ready),\\n        .m_valid(m_valid), .m_data(m_data), .m_ready(m_ready)\\n    );\\n\\n    initial clk = 0;\\n    always #5 clk = ~clk;\\n\\n    task automatic drive(input logic v, input logic [7:0] d, input logic r);\\n        @(negedge clk);\\n        s_valid = v; s_data = d; m_ready = r;\\n    endtask\\n\\n    integer errs;\\n    initial begin\\n        errs = 0;\\n        s_valid = 0; s_data = 0; m_ready = 0;\\n        rst = 1;\\n        repeat (2) @(negedge clk);\\n        rst = 0;\\n        @(negedge clk);\\n        if (m_valid !== 0) begin $display(\\\&quot;FAIL reset m_valid\\\&quot;); errs++; end\\n\\n        // Offer A while downstream not ready: must be captured and held.\\n        drive(1, 8&apos;hA1, 0);\\n        @(negedge clk); // sampling edge\\n        @(negedge clk); // after NBA\\n        if (m_valid !== 1) begin $display(\\\&quot;FAIL A valid\\\&quot;); errs++; end\\n        if (m_data !== 8&apos;hA1) begin $display(\\\&quot;FAIL A data\\\&quot;); errs++; end\\n\\n        // Blocked: change upstream data to B, must NOT overwrite held A.\\n        drive(1, 8&apos;hB2, 0);\\n        @(negedge clk);\\n        @(negedge clk);\\n        if (m_valid !== 1) begin $display(\\\&quot;FAIL hold valid\\\&quot;); errs++; end\\n        if (m_data !== 8&apos;hA1) begin $display(\\\&quot;FAIL hold data %h\\\&quot;, m_data); errs++; end\\n\\n        // Accept A.\\n        drive(1, 8&apos;hB2, 1);\\n        @(negedge clk);\\n        @(negedge clk);\\n        if (m_valid !== 1) begin $display(\\\&quot;FAIL accept valid\\\&quot;); errs++; end\\n        if (m_data !== 8&apos;hB2) begin $display(\\\&quot;FAIL accept data %h\\\&quot;, m_data); errs++; end\\n\\n        // Same-edge consume+receive: offer C while ready, replaces B.\\n        drive(1, 8&apos;hC3, 1);\\n        @(negedge clk);\\n        @(negedge clk);\\n        if (m_valid !== 1) begin $display(\\\&quot;FAIL turnover valid\\\&quot;); errs++; end\\n        if (m_data !== 8&apos;hC3) begin $display(\\\&quot;FAIL turnover data %h\\\&quot;, m_data); errs++; end\\n\\n        // Drain: no new data, ready high -&gt; valid drops.\\n        drive(0, 8&apos;h00, 1);\\n        @(negedge clk);\\n        @(negedge clk);\\n        if (m_valid !== 0) begin $display(\\\&quot;FAIL drain valid\\\&quot;); errs++; end\\n\\n        if (errs == 0) $display(\\\&quot;PASS\\\&quot;);\\n        else $display(\\\&quot;FAIL %0d errors\\\&quot;, errs);\\n        done = 1;\\n        if (errs != 0) $fatal(1, \\\&quot;diag failed\\\&quot;);\\n    end\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q114:api:005"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:005&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\005\\request.json&quot;,&quot;sha256&quot;:&quot;40d1b7e6cc8e32243ed76e490ff55afb07d4e9ad23f48eef9e153eeeba5b8ade&quot;}}</data></node><node id="r04:Q114:api:005:response"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:005:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\005\\response.json&quot;,&quot;sha256&quot;:&quot;df6d1dc585a086910b3a1fa7241dadebc82252ea35021cf5660a48edf0b36615&quot;}}</data></node><node id="r04:Q114:api:005:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:005:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\005\\receipt.json&quot;,&quot;sha256&quot;:&quot;faee60aaa0ca6ae99b30637865a820f231924f1e8715b082a753021dbd93674c&quot;}}</data></node><node id="r04:call_00_YS7co5Yb9Kbb2fSCwg5o2926"><data key="record">{&quot;id&quot;:&quot;r04:call_00_YS7co5Yb9Kbb2fSCwg5o2926&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\005\\response.json&quot;,&quot;sha256&quot;:&quot;df6d1dc585a086910b3a1fa7241dadebc82252ea35021cf5660a48edf0b36615&quot;},&quot;name&quot;:&quot;run_diagnostic&quot;,&quot;arguments&quot;:&quot;{}&quot;}</data></node><node id="r04:Q114:api:006"><data key="record">{&quot;id&quot;:&quot;r04:Q114:api:006&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q114\\api\\006\\request.json&quot;,&quot;sha256&quot;:&quot;6626009055e919239c1c4a960fdcae8a134a02db23cb316a07e4c6ef0328f2fd&quot;}}</data></node><node id="r04:Q114:api:006:response"><data key="record">{&quot;id&quot;:&quot;r04:Q114