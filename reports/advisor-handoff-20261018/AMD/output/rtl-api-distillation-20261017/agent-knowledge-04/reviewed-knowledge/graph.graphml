if (rounded &gt; 16&apos;sd127)\\n            y = 8&apos;sd127;\\n        else if (rounded &lt; -16&apos;sd128)\\n            y = -8&apos;sd128;\\n        else\\n            y = rounded[7:0];\\n    end\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q155:api:004"><data key="record">{&quot;id&quot;:&quot;r04:Q155:api:004&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\004\\request.json&quot;,&quot;sha256&quot;:&quot;bd69fc9a759f0538ad2d132f2ad5f1775c1fa8878acdd27c6c96db87b4cfd64f&quot;}}</data></node><node id="r04:Q155:api:004:response"><data key="record">{&quot;id&quot;:&quot;r04:Q155:api:004:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;0c03af6a01a3c4a63c722d053cbfa1367ad0e3d53bd639a86228c7c5f43baa9a&quot;}}</data></node><node id="r04:Q155:api:004:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q155:api:004:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\004\\receipt.json&quot;,&quot;sha256&quot;:&quot;20d9a8de24bada5030c14c8f99bfcc013b484e4d0400afb3b5e118675c8c51c4&quot;}}</data></node><node id="r04:call_00_MfnjEvluHrxHd9kBDGc64710"><data key="record">{&quot;id&quot;:&quot;r04:call_00_MfnjEvluHrxHd9kBDGc64710&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\004\\response.json&quot;,&quot;sha256&quot;:&quot;0c03af6a01a3c4a63c722d053cbfa1367ad0e3d53bd639a86228c7c5f43baa9a&quot;},&quot;name&quot;:&quot;write_file&quot;,&quot;arguments&quot;:&quot;{\&quot;path\&quot;: \&quot;diag_tb.sv\&quot;, \&quot;content\&quot;: \&quot;module tb(output reg done);\\n    reg signed [15:0] product;\\n    wire signed [7:0] y;\\n    top_module dut(.product(product), .y(y));\\n\\n    integer errors;\\n    reg signed [15:0] p;\\n    reg signed [7:0] expect;\\n\\n    task check(input signed [15:0] pv, input signed [7:0] ev);\\n        begin\\n            product = pv;\\n            #1;\\n            if (y !== ev) begin\\n                $display(\\\&quot;FAIL product=%0d got=%0d expect=%0d\\\&quot;, pv, y, ev);\\n                errors = errors + 1;\\n            end\\n        end\\n    endtask\\n\\n    initial begin\\n        errors = 0;\\n        // exact halves: ties to even\\n        check(16&apos;sd64, 8&apos;sd0);      // 0.5 -&gt; 0 (even)\\n        check(16&apos;sd192, 8&apos;sd2);     // 1.5 -&gt; 2 (even)\\n        check(-16&apos;sd64, 8&apos;sd0);     // -0.5 -&gt; 0 (even)\\n        check(-16&apos;sd192, -8&apos;sd2);   // -1.5 -&gt; -2 (even)\\n        check(16&apos;sd320, 8&apos;sd2);     // 2.5 -&gt; 2 (even)\\n        check(16&apos;sd448, 8&apos;sd4);     // 3.5 -&gt; 4 (even)\\n        check(-16&apos;sd320, -8&apos;sd2);   // -2.5 -&gt; -2 (even)\\n        check(-16&apos;sd448, -8&apos;sd4);   // -3.5 -&gt; -4 (even)\\n        // non-half neighbors\\n        check(16&apos;sd63, 8&apos;sd0);\\n        check(16&apos;sd65, 8&apos;sd1);\\n        check(-16&apos;sd63, 8&apos;sd0);\\n        check(-16&apos;sd65, -8&apos;sd1);\\n        // saturation boundaries\\n        check(16&apos;sd16256, 8&apos;sd127);   // 127.0\\n        check(16&apos;sd16320, 8&apos;sd127);   // 127.5 -&gt; 128 -&gt; saturate 127\\n        check(16&apos;sd16383, 8&apos;sd127);   // 127.99\\n        check(-16&apos;sd16384, -8&apos;sd128); // -128.0\\n        check(-16&apos;sd16448, -8&apos;sd128); // -128.5 -&gt; -129 -&gt; saturate -128\\n        check(-16&apos;sd16320, -8&apos;sd128); // -127.5 -&gt; -128 (even)\\n        check(16&apos;sd0, 8&apos;sd0);\\n        check(16&apos;sd1, 8&apos;sd0);\\n        check(-16&apos;sd1, 8&apos;sd0);\\n        check(16&apos;sd128, 8&apos;sd1);\\n        check(-16&apos;sd128, -8&apos;sd1);\\n\\n        if (errors == 0)\\n            $display(\\\&quot;ALL PASS\\\&quot;);\\n        else\\n            $fatal(1, \\\&quot;FAILURES: %0d\\\&quot;, errors);\\n        done = 1;\\n    end\\nendmodule\\n\&quot;}&quot;}</data></node><node id="r04:Q155:api:005"><data key="record">{&quot;id&quot;:&quot;r04:Q155:api:005&quot;,&quot;kind&quot;:&quot;ApiRequest&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\005\\request.json&quot;,&quot;sha256&quot;:&quot;47c7b43361812d3d1a12dd770084fa5073597f1de68290c20034d747a5599764&quot;}}</data></node><node id="r04:Q155:api:005:response"><data key="record">{&quot;id&quot;:&quot;r04:Q155:api:005:response&quot;,&quot;kind&quot;:&quot;VisibleApiResponse&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\005\\response.json&quot;,&quot;sha256&quot;:&quot;284316798145be7f36d416d17fd155be971124bc22a4861e958363a0db7534cb&quot;}}</data></node><node id="r04:Q155:api:005:receipt"><data key="record">{&quot;id&quot;:&quot;r04:Q155:api:005:receipt&quot;,&quot;kind&quot;:&quot;HttpReceiptWithOriginalBodyHash&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\005\\receipt.json&quot;,&quot;sha256&quot;:&quot;2b0d4d65095d82d7349102a87865eb02f656d1a8ce4359226e280f2b884d8445&quot;}}</data></node><node id="r04:call_00_kimsPRpCAy2cOoIpsiQ61306"><data key="record">{&quot;id&quot;:&quot;r04:call_00_kimsPRpCAy2cOoIpsiQ61306&quot;,&quot;kind&quot;:&quot;ModelRequestedTool&quot;,&quot;artifact&quot;:{&quot;path&quot;:&quot;D:\\AMD\\output\\rtl-api-distillation-20261017\\agent-knowledge-04\\tasks\\Q155\\api\\005\\