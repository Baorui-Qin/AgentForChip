 valid\\\&quot;);\\n  if (a_data!==8&apos;hAA || b_data!==8&apos;hAA) $fatal(1,\\\&quot;data wrong\\\&quot;);\\n  // A accepts first, B stalled\\n  a_ready=1; b_ready=0;\\n  wait_clk(1);\\n  if (a_valid!==0) $fatal(1,\\\&quot;a_valid should clear after A accept\\\&quot;);\\n  if (b_valid!==1) $fatal(1,\\\&quot;b_valid should stay\\\&quot;);\\n  if (b_data!==8&apos;hAA) $fatal(1,\\\&quot;b_data should hold\\\&quot;);\\n  if (s_ready!==0) $fatal(1,\\\&quot;s_ready should stay low while B pending\\\&quot;);\\n  // B accepts later\\n  a_ready=0; b_ready=1;\\n  wait_clk(1);\\n  if (b_valid!==0) $fatal(1,\\\&quot;b_valid should clear\\\&quot;);\\n  if (s_ready!==1) $fatal(1,\\\&quot;s_ready should return high\\\&quot;);\\n  b_ready=0;\\n  wait_clk(1);\\n  // second item, B first then A\\n  s_data=8&apos;h55;\\n  wait_clk(1);\\n  if (a_valid!==1 || b_valid!==1) $fatal(1,\\\&quot;second item not forked\\\&quot;);\\n  b_ready=1; a_ready=0;\\n  wait_clk(1);\\n  if (b_valid!==0 || a_valid!==1) $fatal(1,\\\&quot;B-first order wrong\\\&quot;);\\n  b_ready=0; a_ready=1;\\n  wait_clk(1);\\n  if (a_valid!==0) $fatal(1,\\\&quot;a_valid should clear\\\&quot;);\\n  a_ready=0;\\n  wait_clk(1);\\n  if (a_cnt!==2 || b_cnt!==2) $fatal(1,\\\&quot;accepted counts wrong a=%0d b=%0d\\\&quot;,a_cnt,b_cnt);\\n  if (a_last!==8&apos;h55 || b_last!==8&apos;h55) $fatal(1,\\\&quot;last data wrong\\\&quot;);\\n  // no replacement on completion edge: offer while one branch pending must not be accepted\\n  s_data=8&apos;h33;\\n  wait_clk(1);\\n  if (a_valid!==1 || b_valid!==1) $fatal(1,\\\&quot;third item not forked\\\&quot;);\\n  a_ready=1; b_ready=0;\\n  wait_clk(1);\\n  if (a_valid!==0 || b_valid!==1) $fatal(1,\\\&quot;third A accept wrong\\\&quot;);\\n  if (b_data!==8&apos;h33) $fatal(1,\\\&quot;third data hold wrong\\\&quot;);\\n  a_ready=0; b_ready=1;\\n  wait_clk(1);\\n  if (b_valid!==0) $fatal(1,\\\&quot;third B accept wrong\\\&quot;);\\n  b_ready=0;\\n  wait_clk(1);\\n  done=1;\\nend\\nendmodu